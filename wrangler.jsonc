{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voxbridge-mvp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voxbridge-db",
      "database_id": "b39140d9-b8a5-4ca0-9cee-73b9c1be26f7"
    }
  ],
  "vars": {
    "MAX_DAILY_AI_MESSAGES": "25",
    "MAX_DAILY_NEW_ROOMS_PER_IP": "3",
    "MAX_DAILY_MESSAGES_PER_IP": "8",
    "MAX_MESSAGES_PER_ROOM": "20",
    "ROOM_LIFETIME_DAYS": "7"
  },
  "triggers": {
    "crons": [
      "0 4 * * *"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
