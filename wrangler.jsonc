{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voxbridge-mvp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voxbridge-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "MAX_DAILY_AI_MESSAGES": "25",
    "MAX_DAILY_NEW_ROOMS_PER_IP": "3",
    "MAX_DAILY_MESSAGES_PER_IP": "8",
    "MAX_MESSAGES_PER_ROOM": "20",
    "ROOM_LIFETIME_DAYS": "7"
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}
