{
  "name": "voxbridge-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply voxbridge-db --local",
    "db:remote": "wrangler d1 migrations apply voxbridge-db --remote",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check public/app.js && node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
